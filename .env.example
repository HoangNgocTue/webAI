# Application secrets
SECRET_KEY=change-me-in-production
ADMIN_SECRET_KEY=change-me-in-production

# Database — leave empty to use SQLite (db.sqlite3)
# For Docker/PostgreSQL:
# DATABASE_URL=postgresql://danang_user:danang_pass_2024@localhost:5432/danang_store
DATABASE_URL=

# PostgreSQL password (used by docker-compose.yml)
POSTGRES_PASSWORD=danang_pass_2024

# Anthropic AI (for chatbot)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI / ChatGPT fallback (for chatbot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq fallback (for chatbot)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gmail SMTP (for support ticket emails)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# VNPay (sandbox) — https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/payment/vnpay/return/

# MoMo (sandbox) — https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
