# Application secrets
SECRET_KEY=change-me-in-production
ADMIN_SECRET_KEY=change-me-in-production

# Database — leave empty to use SQLite (db.sqlite3)
# For Docker/PostgreSQL:
# DATABASE_URL=postgresql://danang_user:danang_pass_2024@localhost:5432/danang_store
DATABASE_URL=

# PostgreSQL password (used by docker-compose.yml)
POSTGRES_PASSWORD=danang_pass_2024

# AI chatbot provider: anthropic, groq, or openai
AI_PROVIDER=anthropic

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail SMTP (for support ticket emails)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Public URL used by payment gateways for redirect/webhook callbacks.
# Local example: http://127.0.0.1:8000
# Render example: https://your-app.onrender.com
PUBLIC_BASE_URL=

# MoMo sandbox
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoYKMWACiEi2bsa
MOMO_REQUEST_TYPE=payWithATM
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# PayPal sandbox
# Fill these from https://developer.paypal.com/dashboard/applications/sandbox
# The old Laravel project used PAYPAL_SANDBOX_CLIENT_ID / PAYPAL_SANDBOX_CLIENT_SECRET.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Also supported for compatibility with the old Laravel project:
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_USD=25000
